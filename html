GRUPOS.forEach(function(g){g.items.forEach(function(x){ITEMS[x[0]]={linea:x[1],precio:x[2]};ORDEN_DECO.push(x[0]);});});
RETIRO.concat(REPOS).forEach(function(x){ITEMS[x[0]]={linea:x[3],precio:x[2]};ORDEN_OTROS.push(x[0]);});

var $=function(s,r){return (r||document).querySelector(s);};
var $$=function(s,r){return Array.prototype.slice.call((r||document).querySelectorAll(s));};
var money=function(n){return "$"+n.toLocaleString("es-MX");};
var pad=function(n){return (n<10?"0":"")+n;};
var iso=function(y,m,d){return y+"-"+pad(m+1)+"-"+pad(d);};
var parseISO=function(s){var p=s.split("-").map(Number);return new Date(p[0],p[1]-1,p[2]);};
var cap=function(s){return s.charAt(0).toUpperCase()+s.slice(1);};
function horaTxt(h){var p=h.split(":").map(Number);return (p[0]%12||12)+":"+pad(p[1])+(p[0]>=12?" pm":" am");}
function fechaLarga(s){var d=parseISO(s);return DIAS[d.getDay()]+" "+d.getDate()+" de "+MESES[d.getMonth()]+" de "+d.getFullYear();}

/* ===== estado ===== */
var KEY="maia-nails-v1";
function nuevo(){return {tec:null,largo:null,punta:null,forma:false,cnt:{},fecha:null,hora:null,nombre:""};}
var S=nuevo();
try{var raw=localStorage.getItem(KEY);if(raw){var o=JSON.parse(raw);if(o&&typeof o==="object"){S=Object.assign(nuevo(),o);}}}catch(e){}
function guardar(){try{localStorage.setItem(KEY,JSON.stringify(S));}catch(e){}}

/* ===== disponibilidad ===== */
function slotsDe(f){if(DIAS_CERRADOS.indexOf(f)>-1)return [];return HORARIOS[parseISO(f).getDay()]||[];}
var tomados={};
function esTomado(f,h){return OCUPADOS.indexOf(f+" "+h)>-1||!!tomados[f+" "+h];}
function libre(f,h){
  if(esTomado(f,h))return false;
  var p=h.split(":").map(Number),d=parseISO(f);d.setHours(p[0],p[1],0,0);
  return d>new Date();
}
function estadoDia(f){
  var hs=slotsDe(f);if(!hs.length)return "cerrado";
  var hoy=new Date();hoy.setHours(0,0,0,0);if(parseISO(f)<hoy)return "pasado";
  return hs.some(function(h){return libre(f,h);})?"libre":"lleno";
}
if(S.fecha&&estadoDia(S.fecha)!=="libre"){S.fecha=null;S.hora=null;}
if(S.fecha&&S.hora&&!libre(S.fecha,S.hora)){S.hora=null;}

/* ===== precios ===== */
function lineas(){
  var L=[],i;
  if(S.tec==="acr"){var l=LARGOS[(S.largo||1)-1];L.push({t:"Acrílico · Largo "+l.n,m:l.precio});}
  else if(S.tec==="gel"){L.push({t:"Gel semipermanente",m:150});}
  else if(S.tec==="rub"){L.push({t:"Rubber Gel",m:200});}
  if(S.punta){PUNTAS.forEach(function(p){if(p.id===S.punta)L.push({t:"Puntas "+p.nombre.toLowerCase(),m:null});});}
  ORDEN_DECO.forEach(function(id){var n=S.cnt[id]||0;if(n>0)L.push({t:ITEMS[id].linea+" ×"+n,m:n*ITEMS[id].precio});});
  if(S.forma)L.push({t:"Cambio de forma",m:CAMBIO_FORMA});
  ORDEN_OTROS.forEach(function(id){var n=S.cnt[id]||0;if(n>0)L.push({t:ITEMS[id].linea+" ×"+n,m:n*ITEMS[id].precio});});
  return L;
}
function total(){return lineas().reduce(function(a,l){return a+(l.m||0);},0);}
var ok1=function(){return total()>0;};
var ok2=function(){return !!(S.fecha&&S.hora&&S.nombre.trim().length>=2&&libre(S.fecha,S.hora));};

/* ===== construcción del DOM ===== */
$("#tecnicas").innerHTML=TECNICAS.map(function(t){
  return '<button type="button" class="pill" data-tec="'+t.id+'" aria-pressed="false"><span class="ico" aria-hidden="true">'+t.emoji+'</span><span class="nm">'+t.nombre+(t.sub?'<span class="sub">'+t.sub+'</span>':'')+'</span><span class="pr">'+t.precio+'</span></button>';
}).join("");
$("#largos").innerHTML=LARGOS.map(function(l){
  return '<button type="button" class="pill sm" data-largo="'+l.n+'" aria-pressed="false"><span class="nm">Largo '+l.n+'</span><span class="pr">'+money(l.precio)+'</span></button>';
}).join("");
$("#puntas").innerHTML=PUNTAS.map(function(p){
  return '<button type="button" class="tip" data-punta="'+p.id+'" aria-pressed="false"><svg viewBox="0 0 60 92" aria-hidden="true"><path class="shape" d="'+p.d+'"/><path class="shine" d="M23 34V66"/></svg><span>'+p.nombre+'</span></button>';
}).join("");
function fila(x){
  return '<div class="row" data-row="'+x[0]+'"><div class="nm">'+x[1]+(x[3]&&x[0].indexOf("-")<0?'<span class="sub">'+x[3]+'</span>':'')+'</div><div class="pr">'+money(x[2])+'</div><div class="stp"><button type="button" data-stp="'+x[0]+'" data-d="-1" aria-label="Quitar uña: '+x[1]+'">−</button><output aria-live="polite">0</output><button type="button" data-stp="'+x[0]+'" data-d="1" aria-label="Agregar uña: '+x[1]+'">+</button></div></div>';
}
$("#grupos").innerHTML=GRUPOS.map(function(g){
  return '<div class="grp"><h3>'+g.t+(g.nota?'<small>'+g.nota+'</small>':'')+'</h3>'+g.items.map(fila).join("")+'</div>';
}).join("");
$("#retiro").innerHTML=RETIRO.map(fila).join("");
$("#repos").innerHTML=REPOS.map(fila).join("");
$("#dows").innerHTML=["Lun","Mar","Mié","Jue","Vie","Sáb","Dom"].map(function(d){return '<div class="dow">'+d+'</div>';}).join("");

/* ===== render ===== */
function renderResumen(el){
  var L=lineas();
  if(!L.length){el.innerHTML='<p class="empty">Aún no eliges ningún servicio.</p>';return;}
  el.innerHTML=L.map(function(l){return '<div class="ln"><span>'+l.t+'</span><b>'+(l.m==null?"":money(l.m))+'</b></div>';}).join("")+'<div class="ln tt"><span>Total estimado</span><b>'+money(total())+'</b></div>';
}
function sync(){
  $$("[data-tec]").forEach(function(b){b.setAttribute("aria-pressed",String(S.tec===b.dataset.tec));});
  $("#blk-largo").hidden=S.tec!=="acr";
  $("#nota-gel").hidden=!(S.tec==="gel"||S.tec==="rub");
  $$("[data-largo]").forEach(function(b){b.setAttribute("aria-pressed",String(S.largo===Number(b.dataset.largo)));});
  $$("[data-punta]").forEach(function(b){b.setAttribute("aria-pressed",String(S.punta===b.dataset.punta));});
  $("#forma").setAttribute("aria-pressed",String(S.forma));
  $$("[data-row]").forEach(function(r){
    var id=r.dataset.row,n=S.cnt[id]||0;
    $("output",r).textContent=n;r.classList.toggle("on",n>0);
    $$("[data-stp]",r).forEach(function(b){b.disabled=(b.dataset.d==="-1"&&n<=0)||(b.dataset.d==="1"&&n>=10);});
  });
  $("#nombre").value!==S.nombre&&($("#nombre").value=S.nombre);
  renderResumen($("#resumen"));
  updateBar();
}

var hoy=new Date(),vY=hoy.getFullYear(),vM=hoy.getMonth(),minY=vY,minM=vM;
var maxD=new Date(hoy.getFullYear(),hoy.getMonth()+MESES_ADELANTE,1),maxY=maxD.getFullYear(),maxM=maxD.getMonth();
function renderCal(){
  $("#mes").textContent=cap(MESES[vM])+" "+vY;
  $("#prev").disabled=(vY===minY&&vM===minM);
  $("#next-mes").disabled=(vY===maxY&&vM===maxM);
  var off=(new Date(vY,vM,1).getDay()+6)%7,n=new Date(vY,vM+1,0).getDate(),h="",d;
  for(d=0;d<off;d++)h+='<div></div>';
  var hoyISO=iso(hoy.getFullYear(),hoy.getMonth(),hoy.getDate());
  for(d=1;d<=n;d++){
    var f=iso(vY,vM,d),e=estadoDia(f);
    h+='<button type="button" class="day'+(e==="libre"?" libre":"")+(e==="lleno"?" lleno":"")+(f===hoyISO?" hoy":"")+'" data-fecha="'+f+'" aria-pressed="'+(S.fecha===f)+'" aria-label="'+fechaLarga(f)+(e==="libre"?"":", no disponible")+'"'+(e==="libre"?"":" disabled")+'>'+d+'</button>';
  }
  $("#dias").innerHTML=h;
}
function renderSlots(){
  var box=$("#slots"),t=$("#slots-title");
  if(!S.fecha){t.textContent="Horarios";box.innerHTML='<p class="empty" style="grid-column:1/-1">Elige un día para ver los horarios disponibles.</p>';return;}
  t.textContent="Horarios · "+cap(DIAS[parseISO(S.fecha).getDay()])+" "+parseISO(S.fecha).getDate()+" de "+MESES[parseISO(S.fecha).getMonth()];
  box.innerHTML=slotsDe(S.fecha).map(function(h){
    var l=libre(S.fecha,h),t=esTomado(S.fecha,h);
    if(modoSalon){return '<button type="button" class="slot" data-hora="'+h+'" aria-pressed="'+t+'"><b>'+horaTxt(h)+'</b><span>'+(t?"Ocupado · toca para liberar":"Libre · toca para bloquear")+'</span></button>';}
    return '<button type="button" class="slot" data-hora="'+h+'" aria-pressed="'+(S.hora===h)+'"'+(l?"":" disabled")+'><b>'+horaTxt(h)+'</b><span>'+(l?"Disponible":"No disponible")+'</span></button>';
  }).join("");
}

/* ===== base compartida (citas) ===== */
var DB=null,UID=null,modoSalon=false,esSalon=false;
function slotId(f,h){return f+"_"+h.replace(":","-");}
function refrescar(){
  if(S.fecha&&estadoDia(S.fecha)!=="libre"&&!modoSalon){S.fecha=null;S.hora=null;}
  if(S.fecha&&S.hora&&!libre(S.fecha,S.hora)&&!modoSalon){S.hora=null;}
  if(cur==="agenda"){renderCal();renderSlots();}
  updateBar();
}
function reservar(f,h){
  if(!DB)return Promise.resolve(false);
  var ref=DB.doc("citas/"+slotId(f,h));
  return ref.acquire({holder:UID||("v"+Math.random().toString(36).slice(2)),ttlMs:5000}).then(function(r){
    if(!r.acquired)return false;
    return ref.get().then(function(s){
      if(s.exists)return false;
      return ref.set({fecha:f,hora:h,estado:"reservada",creada:Date.now()}).then(function(){return true;});
    });
  }).catch(function(){return false;});
}
function alternarSalon(f,h){
  if(!DB)return;
  var ref=DB.doc("citas/"+slotId(f,h));
  if(esTomado(f,h)){ref.delete().catch(function(){});}
  else{ref.set({fecha:f,hora:h,estado:"bloqueada",creada:Date.now()}).catch(function(){});}
}
function iniciarDB(){
  if(!window.claude||!window.claude.use)return;
  Promise.all([window.claude.use("db"),window.claude.use("user")]).then(function(r){
    DB=r[0];var U=r[1];if(!DB)return;
    if(U){try{esSalon=!!U.canEdit();}catch(e){} U.id().then(function(i){UID=i;}).catch(function(){});}
    var pm=$("#panel-salon");if(pm)pm.hidden=!esSalon;
    DB.collection("citas").onSnapshot(function(snap){
      var t={};snap.docs.forEach(function(d){var v=d.data();if(v&&v.fecha&&v.hora)t[v.fecha+" "+v.hora]=1;});
      tomados=t;refrescar();
    },function(){});
  }).catch(function(){});
}

/* ===== navegación ===== */
var STEPS=["cotiza","agenda","confirma"],cur="cotiza";
function permitido(s){return s==="cotiza"||(s==="agenda"&&ok1())||(s==="confirma"&&ok1()&&ok2());}
function waHref(){
  var L=lineas();
  var msg=["¡Hola, Quiero confirmar mi cita!🌸","","Nombre: "+S.nombre.trim(),"Servicio(s):"].concat(L.map(function(l){return "• "+l.t;})).concat(["","Fecha: "+fechaLarga(S.fecha),"Hora: "+horaTxt(S.hora),"Precio estimado: "+money(total())]).join("\n");
  return "https://wa.me/"+WHATSAPP+"?text="+encodeURIComponent(msg);
}
function updateBar(){
  var ok,hint="",label;
  if(cur==="cotiza"){ok=ok1();label="Continuar a la agenda";if(!ok)hint="Elige una técnica o un servicio para continuar.";}
  else{ok=ok2();label="Revisar mi cita";if(!ok){var f=[];if(!S.fecha)f.push("fecha");if(!S.hora)f.push("hora");if(S.nombre.trim().length<2)f.push("nombre");hint=f.length?"Falta: "+f.join(", ")+".":"Ese horario ya no está disponible. Elige otro.";}}
  $("#total").textContent=money(total());
  $("#next").disabled=!ok;$("#next").textContent=label;
  $("#hint").hidden=!hint;$("#hint").textContent=hint;
  $$(".steps [data-go]").forEach(function(b){var s=b.dataset.go;b.setAttribute("aria-current",s===cur?"step":"false");b.disabled=s!==cur&&!permitido(s);});
}
function go(s){
  if(STEPS.indexOf(s)<0)s="cotiza";
  while(!permitido(s))s=STEPS[STEPS.indexOf(s)-1];
  cur=s;
  STEPS.forEach(function(x){$("#p-"+x).hidden=x!==s;});
  $("#bar").hidden=s==="confirma";
  document.body.classList.toggle("no-bar",s==="confirma");
  if(s==="agenda"){renderCal();renderSlots();}
  if(s==="confirma"){
    $("#f-nombre").textContent=S.nombre.trim();$("#f-fecha").textContent=cap(fechaLarga(S.fecha));$("#f-hora").textContent=horaTxt(S.hora);
    renderResumen($("#resumen-final"));$("#cta").href=waHref();$("#enviado").hidden=true;
  }
  updateBar();
  try{if(location.hash!=="#"+s)location.hash=s;}catch(e){}
  window.scrollTo(0,0);
}

/* ===== eventos ===== */
function cambio(){guardar();sync();}
document.addEventListener("click",function(e){
  var b=e.target.closest("button,a");if(!b)return;
  if(b.dataset.tec){S.tec=S.tec===b.dataset.tec?null:b.dataset.tec;if(S.tec==="acr"&&!S.largo)S.largo=1;cambio();return;}
  if(b.dataset.largo){S.largo=Number(b.dataset.largo);cambio();return;}
  if(b.dataset.punta){S.punta=S.punta===b.dataset.punta?null:b.dataset.punta;cambio();return;}
  if(b.id==="forma"){S.forma=!S.forma;cambio();return;}
  if(b.dataset.stp){var id=b.dataset.stp,n=(S.cnt[id]||0)+Number(b.dataset.d);S.cnt[id]=Math.max(0,Math.min(10,n));cambio();return;}
  if(b.dataset.fecha){S.fecha=b.dataset.fecha;if(S.hora&&!libre(S.fecha,S.hora))S.hora=null;guardar();renderCal();renderSlots();updateBar();return;}
  if(b.dataset.hora){
    if(modoSalon){alternarSalon(S.fecha,b.dataset.hora);return;}
    S.hora=b.dataset.hora;guardar();renderSlots();updateBar();return;}
  if(b.id==="modo-salon"){modoSalon=!modoSalon;b.setAttribute("aria-pressed",String(modoSalon));b.textContent=modoSalon?"Salir del modo salón":"Modo salón: bloquear horarios";if(!modoSalon)refrescar();else{renderCal();renderSlots();}return;}
  if(b.id==="prev"){vM--;if(vM<0){vM=11;vY--;}renderCal();return;}
  if(b.id==="next-mes"){vM++;if(vM>11){vM=0;vY++;}renderCal();return;}
  if(b.dataset.go){go(b.dataset.go);return;}
  if(b.id==="next"){go(STEPS[STEPS.indexOf(cur)+1]);return;}
  if(b.dataset.act==="back"){go(STEPS[Math.max(0,STEPS.indexOf(cur)-1)]);return;}
  if(b.dataset.act==="clear"){
    if(b.dataset.arm){S=nuevo();guardar();vY=minY;vM=minM;$$("[data-act=clear]").forEach(function(x){x.textContent="Limpiar todo";delete x.dataset.arm;});sync();go("cotiza");}
    else{b.dataset.arm="1";b.textContent="¿Borrar todo? Toca otra vez";setTimeout(function(){if(b.dataset.arm){delete b.dataset.arm;b.textContent="Limpiar todo";}},3500);}
    return;
  }
  if(b.id==="cta"){
    if(!(ok1()&&ok2())){e.preventDefault();go("agenda");return;}
    b.href=waHref();$("#enviado").hidden=false;
    reservar(S.fecha,S.hora);
  }
});
$("#nombre").addEventListener("input",function(e){S.nombre=e.target.value;guardar();updateBar();});
window.addEventListener("hashchange",function(){var h=location.hash.slice(1);if(h!==cur)go(h);});

/* ===== inicio ===== */
if(S.fecha){var pf=parseISO(S.fecha);vY=pf.getFullYear();vM=pf.getMonth();}
sync();
go(location.hash.slice(1)||"cotiza");
iniciarDB();
})();
</script>

</body></html>
