<!doctype html><html><head><meta charset=utf8><meta name=viewport content="width=device-width,initial-scale=1,viewport-fit=cover"><style>:root{color-scheme:light;box-sizing:border-box;padding-top:env(safe-area-inset-top,0px);padding-bottom:env(safe-area-inset-bottom,0px)}html{scroll-padding-top:env(safe-area-inset-top,0px)}body{margin:0;padding:0;font:14px -apple-system,BlinkMacSystemFont,sans-serif;background:#fff;color:#000}img{max-width:100%}[hidden]:not([hidden=until-found i]){display:none!important}</style></head><body>
<title>Maia Nails</title>
<meta name="claude:viewport-fit-sides" content="cover">
<link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Bodoni+Moda:ital,opsz,wght@0,6..96,400..600;1,6..96,400..600&family=Jost:wght@400;500;600&display=swap">
<style>
/* Concepto: formulario de salón en una columna, tres pasos (cotiza, agenda, confirma), todo en pastillas ovaladas alineadas. Blanco rosado con un solo rosa empolvado. */
:root{
  --bg:#fffbfc; --surface:#ffffff; --blush:#fbeef2; --blush-2:#f6dbe4; --rose:#dca2b5;
  --rose-ink:#a45570; --on-accent:#ffffff; --fg:#3b2b31; --muted:#7e666e; --line:#f1e1e7;
  --shadow:0 12px 28px -14px rgba(164,85,112,.55);
  --display:"Bodoni Moda","Didot","Georgia",serif;
  --body:"Jost","Avenir Next","Segoe UI",system-ui,sans-serif;
}
@media (prefers-color-scheme: dark){
  :root:not([data-theme="light"]){
    --bg:#1f1519; --surface:#2a1d23; --blush:#38252d; --blush-2:#4a303b; --rose:#8f5b70;
    --rose-ink:#f0b3c6; --on-accent:#2a1520; --fg:#f8ecef; --muted:#c3a9b2; --line:#3f2c35;
    --shadow:0 12px 28px -14px rgba(0,0,0,.7); color-scheme:dark;
  }
}
:root[data-theme="dark"]{
  --bg:#1f1519; --surface:#2a1d23; --blush:#38252d; --blush-2:#4a303b; --rose:#8f5b70;
  --rose-ink:#f0b3c6; --on-accent:#2a1520; --fg:#f8ecef; --muted:#c3a9b2; --line:#3f2c35;
  --shadow:0 12px 28px -14px rgba(0,0,0,.7); color-scheme:dark;
}
*{box-sizing:border-box}
body{background:var(--bg);color:var(--fg);font-family:var(--body);font-size:16px;line-height:1.45;
  padding-block:20px 160px;padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
body.no-bar{padding-block-end:56px}
button,input{font:inherit;color:inherit}
button{cursor:pointer}
:focus-visible{outline:3px solid var(--rose-ink);outline-offset:2px}
.shell{max-width:640px;margin:0 auto;display:flex;flex-direction:column;gap:26px}

/* encabezado */
.hero{position:relative;isolation:isolate;padding:22px 0 0}
.hero::before{content:"";position:absolute;z-index:-1;top:-6px;right:0;width:190px;height:190px;border-radius:50%;background:radial-gradient(circle at 35% 35%,var(--blush-2),transparent 68%)}
.hero::after{content:"";position:absolute;z-index:-1;top:20px;right:44px;width:92px;height:92px;border-radius:50%;border:1px solid var(--rose);opacity:.55}
.tag{font-size:12px;letter-spacing:.2em;text-transform:uppercase;color:var(--rose-ink);font-weight:500}
h1{font-family:var(--display);font-weight:500;font-size:clamp(36px,10vw,56px);line-height:1.02;letter-spacing:-.01em;margin:10px 0 12px;text-wrap:balance}
h1 em{font-style:italic;font-weight:400;color:var(--rose-ink)}
.lede{color:var(--muted);margin:0;max-width:46ch}

/* pasos */
.steps{display:flex;gap:8px;list-style:none;margin:0;padding:0}
.steps li{flex:1;min-width:0}
.steps button{width:100%;display:flex;align-items:center;justify-content:center;gap:8px;min-height:44px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);color:var(--muted);font-weight:500;font-size:14px;padding:0 8px}
.steps button span{width:24px;height:24px;border-radius:50%;background:var(--blush);color:var(--rose-ink);display:grid;place-items:center;font-size:12px;font-weight:600;flex:none}
.steps button[aria-current="step"]{background:var(--blush);border-color:var(--rose);color:var(--fg)}
.steps button:disabled{opacity:.55;cursor:default}

/* bloques */
.page{display:flex;flex-direction:column;gap:34px}
.blk{display:flex;flex-direction:column;gap:12px;min-width:0}
h2{font-family:var(--display);font-weight:500;font-size:26px;line-height:1.15;margin:0}
.help{color:var(--muted);font-size:14px;margin:-6px 0 0}
.grp{display:flex;flex-direction:column;gap:10px;min-width:0}
h3{font-size:12px;font-weight:600;letter-spacing:.16em;text-transform:uppercase;color:var(--rose-ink);margin:8px 0 0;display:flex;gap:10px;align-items:baseline;flex-wrap:wrap}
h3 small{font-size:12px;font-weight:400;letter-spacing:0;text-transform:none;color:var(--muted)}
.list{display:flex;flex-direction:column;gap:10px}

/* pastillas */
.pill{display:grid;grid-template-columns:auto minmax(0,1fr) auto;align-items:center;gap:12px;width:100%;min-height:60px;padding:8px 20px 8px 9px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);text-align:left}
.pill .ico{width:44px;height:44px;border-radius:50%;background:var(--blush);display:grid;place-items:center;font-size:21px}
.pill .nm{font-weight:500;min-width:0}
.pill .sub{display:block;font-size:13px;color:var(--muted);font-weight:400}
.pill .pr{font-weight:600;font-variant-numeric:tabular-nums;white-space:nowrap}
.pill[aria-pressed="true"]{background:var(--blush);border-color:var(--rose)}
.pill[aria-pressed="true"] .ico{background:var(--surface)}
.pill.sm{grid-template-columns:minmax(0,1fr) auto;min-height:50px;padding:8px 18px}
.pill.flat{grid-template-columns:minmax(0,1fr) auto;padding-left:20px}
.lengths{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
@media (min-width:560px){.lengths{grid-template-columns:repeat(4,minmax(0,1fr))}}
.note{background:var(--blush);border-radius:22px;padding:14px 18px;font-size:14px;color:var(--fg);margin:0}

/* puntas */
.tips{display:grid;grid-template-columns:repeat(4,minmax(0,1fr));gap:10px}
.tip{display:flex;flex-direction:column;align-items:center;gap:6px;padding:12px 4px 10px;border-radius:26px;border:1.5px solid var(--line);background:var(--surface)}
.tip svg{width:44px;height:66px;display:block}
.tip .shape{fill:var(--blush);stroke:var(--rose);stroke-width:2;stroke-linejoin:round}
.tip .shine{stroke:var(--surface);stroke-width:3;stroke-linecap:round;opacity:.8}
.tip span{font-size:13px;font-weight:500}
.tip[aria-pressed="true"]{background:var(--blush);border-color:var(--rose)}
.tip[aria-pressed="true"] .shape{fill:var(--blush-2);stroke:var(--rose-ink)}

/* filas con contador */
.row{display:grid;grid-template-columns:minmax(0,1fr) 54px auto;align-items:center;gap:10px;min-height:58px;padding:8px 12px 8px 20px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface)}
.row .nm{font-weight:500;min-width:0}
.row .sub{display:block;font-size:13px;color:var(--muted);font-weight:400}
.row .pr{text-align:right;font-weight:600;font-variant-numeric:tabular-nums}
.row.on{background:var(--blush);border-color:var(--rose)}
.stp{display:flex;align-items:center;gap:4px}
.stp button{width:36px;height:36px;padding:0;border-radius:50%;border:1.5px solid var(--rose);background:var(--surface);color:var(--rose-ink);font-size:20px;line-height:1;display:grid;place-items:center}
.stp button:disabled{opacity:.35;cursor:default}
.stp output{min-width:26px;text-align:center;font-weight:600;font-variant-numeric:tabular-nums}

/* resumen */
.card{background:var(--surface);border:1.5px solid var(--line);border-radius:28px;padding:18px 20px}
.ln{display:flex;justify-content:space-between;gap:14px;padding:9px 0;border-bottom:1px solid var(--line)}
.ln:last-child{border-bottom:0}
.ln b{font-variant-numeric:tabular-nums;white-space:nowrap;font-weight:600}
.ln.tt{font-family:var(--display);font-size:20px;padding-top:14px}
.empty{margin:0;color:var(--muted)}
.facts{display:grid;grid-template-columns:repeat(auto-fit,minmax(150px,1fr));gap:14px;margin-bottom:8px}
.facts dt{font-size:12px;letter-spacing:.14em;text-transform:uppercase;color:var(--rose-ink);font-weight:600}
.facts dd{margin:2px 0 0;font-family:var(--display);font-size:20px;overflow-wrap:anywhere}

/* calendario */
.cal{background:var(--surface);border:1.5px solid var(--line);border-radius:30px;padding:16px 14px 14px}
.cal-head{display:flex;align-items:center;justify-content:space-between;margin-bottom:10px}
.cal-head b{font-family:var(--display);font-weight:500;font-size:22px}
.cal-head button{width:42px;height:42px;border-radius:50%;border:1.5px solid var(--line);background:var(--bg);font-size:20px;line-height:1;display:grid;place-items:center;padding:0}
.cal-head button:disabled{opacity:.35;cursor:default}
.grid7{display:grid;grid-template-columns:repeat(7,minmax(0,1fr));gap:4px}
.dow{text-align:center;font-size:12px;letter-spacing:.08em;text-transform:uppercase;color:var(--muted);padding-bottom:6px}
.day{aspect-ratio:1;width:100%;border-radius:50%;border:0;background:transparent;display:grid;place-items:center;font-variant-numeric:tabular-nums;padding:0}
.day.libre{background:var(--blush);font-weight:600}
.day:disabled{color:var(--muted);opacity:.4;cursor:default}
.day.lleno{text-decoration:line-through}
.day.hoy{box-shadow:inset 0 0 0 1.5px var(--rose)}
.day[aria-pressed="true"]{background:var(--rose-ink);color:var(--on-accent);box-shadow:none}
.legend{display:flex;flex-wrap:wrap;gap:6px 18px;margin-top:12px;font-size:13px;color:var(--muted)}
.legend i{display:inline-block;width:12px;height:12px;border-radius:50%;margin-right:6px;vertical-align:-1px;background:var(--blush);border:1.5px solid var(--rose)}
.legend i.off{background:transparent;border-color:var(--line)}
.slots{display:grid;grid-template-columns:repeat(2,minmax(0,1fr));gap:10px}
.slot{min-height:58px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);display:flex;flex-direction:column;align-items:center;justify-content:center;padding:6px 10px}
.slot b{font-weight:600;font-variant-numeric:tabular-nums}
.slot span{font-size:12px;color:var(--muted)}
.slot[aria-pressed="true"]{background:var(--blush);border-color:var(--rose-ink)}
.slot:disabled{opacity:.5;background:var(--bg);cursor:default}
input[type=text]{width:100%;min-height:54px;border-radius:999px;border:1.5px solid var(--line);background:var(--surface);padding:0 22px}
input[type=text]::placeholder{color:var(--muted)}

/* botones */
.primary,.cta{min-height:54px;border-radius:999px;border:0;background:var(--rose-ink);color:var(--on-accent);font-weight:600;padding:0 26px;text-decoration:none;display:inline-flex;align-items:center;justify-content:center;text-align:center}
.primary:disabled{opacity:.45;cursor:default}
.cta{width:100%;min-height:62px;font-size:18px;box-shadow:var(--shadow)}
.ghost{min-height:48px;border-radius:999px;border:1.5px solid var(--rose);background:transparent;color:var(--rose-ink);font-weight:500;padding:0 22px}
.foot{display:flex;flex-wrap:wrap;gap:10px;padding-top:22px;border-top:1px solid var(--line)}
.sent{margin:0;font-size:14px;color:var(--muted)}
.bar{position:fixed;left:0;right:0;bottom:0;z-index:5;background:var(--surface);border-top:1px solid var(--line);
  padding-top:12px;padding-bottom:calc(12px + env(safe-area-inset-bottom,0px));padding-left:max(16px,env(safe-area-inset-left,0px));padding-right:max(16px,env(safe-area-inset-right,0px))}
.bar-in{max-width:640px;margin:0 auto;display:flex;flex-direction:column;gap:8px}
.bar-row{display:flex;align-items:center;justify-content:space-between;gap:14px}
.tot span{display:block;font-size:12px;letter-spacing:.12em;text-transform:uppercase;color:var(--muted)}
.tot b{font-family:var(--display);font-size:28px;font-weight:500;font-variant-numeric:tabular-nums;line-height:1.1}
.hint{margin:0;font-size:13px;color:var(--muted)}
@media (prefers-reduced-motion:no-preference){.pill,.row,.tip,.day,.slot{transition:background .15s,border-color .15s}}
</style>

<div class="shell">
  <header class="hero">
    <span class="tag">Studio de uñas</span>
    <h1>Bienvenida a <em>Maia Nails</em> 🌸</h1>
    <p class="lede">Arma tu set, mira cuánto cuesta y agenda tu cita. Al final se abre WhatsApp con tu mensaje listo.</p>
  </header>

  <ol class="steps" aria-label="Pasos">
    <li><button type="button" data-go="cotiza"><span>1</span>Cotiza</button></li>
    <li><button type="button" data-go="agenda"><span>2</span>Agenda</button></li>
    <li><button type="button" data-go="confirma"><span>3</span>Confirma</button></li>
  </ol>

  <main>
    <!-- PASO 1 -->
    <section class="page" id="p-cotiza" aria-label="Cotiza tu servicio">
      <div class="blk">
        <h2>Técnica</h2>
        <div class="list" id="tecnicas"></div>
        <p class="note" id="nota-gel" hidden>En gel semipermanente y rubber gel se incluyen 2 tonos lisos a elegir. Cualquier diseño extra incrementa el precio.</p>
      </div>

      <div class="blk" id="blk-largo" hidden>
        <h2>Largo</h2>
        <p class="help">Para acrílico. A mayor largo, mayor precio.</p>
        <div class="lengths" id="largos"></div>
      </div>

      <div class="blk">
        <h2>Puntas de salón</h2>
        <p class="help">Elige la forma de tus uñas.</p>
        <div class="tips" id="puntas"></div>
      </div>

      <div class="blk">
        <h2>Decoraciones (extras)</h2>
        <p class="help">Costo por uña. Indica en cuántas uñas quieres cada una.</p>
        <div id="grupos" class="list" style="gap:18px"></div>
        <div class="grp">
          <h3>Forma</h3>
          <button type="button" class="pill flat" id="forma" aria-pressed="false"><span class="nm">Cambio de forma</span><span class="pr">$20</span></button>
        </div>
      </div>

      <div class="blk">
        <h2>Retiro</h2>
        <p class="help">Si traes material de otra técnica. Costo por uña.</p>
        <div class="list" id="retiro"></div>
      </div>

      <div class="blk">
        <h2>Reposiciones</h2>
        <p class="help">Para reparar uñas de un set anterior. Costo por uña.</p>
        <div class="list" id="repos"></div>
      </div>

      <div class="blk">
        <h2>Tu selección</h2>
        <div class="card" id="resumen"></div>
      </div>

      <div class="foot">
        <button type="button" class="ghost" data-act="clear">Limpiar todo</button>
      </div>
    </section>

    <!-- PASO 2 -->
    <section class="page" id="p-agenda" aria-label="Agenda tu cita" hidden>
      <div class="blk">
        <h2>Elige tu fecha</h2>
        <p class="help">Lunes a viernes: 9:00 am, 1:00 pm, 4:00 pm y 8:00 pm. Sábado: 9:00 am y 1:00 pm. Domingo cerrado.</p>
        <div class="cal">
          <div class="cal-head">
            <button type="button" id="prev" aria-label="Mes anterior">‹</button>
            <b id="mes"></b>
            <button type="button" id="next-mes" aria-label="Mes siguiente">›</button>
          </div>
          <div class="grid7" id="dows"></div>
          <div class="grid7" id="dias"></div>
          <div class="legend"><span><i></i>Día con horarios</span><span><i class="off"></i>Sin horarios o cerrado</span></div>
        </div>
      </div>

      <div class="blk">
        <h2 id="slots-title">Horarios</h2>
        <div class="slots" id="slots"></div>
      </div>

      <div class="blk" id="panel-salon" hidden>
        <button type="button" class="ghost" id="modo-salon" aria-pressed="false">Modo salón: bloquear horarios</button>
      </div>

      <div class="blk">
        <h2>Tus datos</h2>
        <input type="text" id="nombre" placeholder="Nombre de la clienta" autocomplete="name" aria-label="Nombre de la clienta" maxlength="60">
      </div>

      <div class="foot">
        <button type="button" class="ghost" data-act="back">Regresar</button>
        <button type="button" class="ghost" data-act="clear">Limpiar todo</button>
      </div>
    </section>

    <!-- PASO 3 -->
    <section class="page" id="p-confirma" aria-label="Confirma tu cita" hidden>
      <div class="blk">
        <h2>Revisa tu cita</h2>
        <div class="card">
          <dl class="facts">
            <div><dt>Nombre</dt><dd id="f-nombre"></dd></div>
            <div><dt>Fecha</dt><dd id="f-fecha"></dd></div>
            <div><dt>Hora</dt><dd id="f-hora"></dd></div>
          </dl>
          <div id="resumen-final"></div>
        </div>
      </div>

      <div class="blk">
        <a class="cta" id="cta" href="https://wa.me/" target="_blank" rel="noopener">Confirmar cita por WhatsApp</a>
        <p class="sent" id="enviado" hidden>Se abrió WhatsApp con tu mensaje. Envíalo y tu cita queda confirmada cuando Maia te responda.</p>
        <p class="sent">El precio es estimado y se confirma en el salón.</p>
      </div>

      <div class="foot">
        <button type="button" class="ghost" data-act="back">Regresar</button>
        <button type="button" class="ghost" data-act="clear">Limpiar todo</button>
      </div>
    </section>
  </main>
</div>

<div class="bar" id="bar">
  <div class="bar-in">
    <p class="hint" id="hint" hidden></p>
    <div class="bar-row">
      <div class="tot"><span>Total estimado</span><b id="total">$0</b></div>
      <button type="button" class="primary" id="next">Continuar</button>
    </div>
  </div>
</div>

